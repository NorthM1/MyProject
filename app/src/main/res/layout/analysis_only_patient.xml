<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 顶部导航栏 -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="4dp"
        app:title="对比分析"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 视频展示区 (使用 ScrollView 以适配小屏幕) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintBottom_toTopOf="@id/bottom_action_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 视频对比卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                android:layout_marginBottom="16dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- 标准示例 (医生) -->
                    <TextView
                        android:id="@+id/tv_label_doctor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="标准示范"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:elevation="2dp"
                        android:layout_margin="8dp"
                        app:layout_constraintTop_toTopOf="@id/video_container_doctor"
                        app:layout_constraintStart_toStartOf="@id/video_container_doctor" />

                    <FrameLayout
                        android:id="@+id/video_container_doctor"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintDimensionRatio="H,16:9"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <VideoView
                            android:id="@+id/video_view_doctor"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <com.example.myproject.OverlayView
                            android:id="@+id/overlay_doctor"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </FrameLayout>

                    <!-- 分割线 -->
                    <View
                        android:id="@+id/divider_video"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        app:layout_constraintTop_toBottomOf="@id/video_container_doctor" />

                    <!-- 用户视频 (患者) -->
                    <TextView
                        android:id="@+id/tv_label_patient"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="您的动作"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:elevation="2dp"
                        android:layout_margin="8dp"
                        app:layout_constraintTop_toTopOf="@id/video_container_patient"
                        app:layout_constraintStart_toStartOf="@id/video_container_patient" />

                    <FrameLayout
                        android:id="@+id/video_container_patient"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintDimensionRatio="H,16:9"
                        app:layout_constraintTop_toBottomOf="@id/divider_video"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <VideoView
                            android:id="@+id/video_view_patient"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <com.example.myproject.OverlayView
                            android:id="@+id/overlay_patient"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </FrameLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 统一的播放控制条 (原 SeekBar 区域) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_playback_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                android:layout_marginBottom="16dp"
                android:visibility="visible"> <!-- 设置为可见以便预览 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp">

                    <ImageButton
                        android:id="@+id/iv_pause"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="?attr/colorPrimary" />

                    <SeekBar
                        android:id="@+id/seek_bar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progress="35" />

                    <TextView
                        android:id="@+id/tv_time_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:14 / 0:40"
                        android:textColor="#666666"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <!-- 评分结果卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_score_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp"
                android:visibility="visible"> <!-- 设置为可见以便预览 -->

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_score_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="总体评分"
                        android:textColor="#666666"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="82"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_score_title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="8dp"
                        android:text="分"
                        android:textColor="#666666"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="@id/tv_score"
                        app:layout_constraintStart_toEndOf="@id/tv_score" />

                    <!-- 状态标签 -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/tv_result"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="动作良好"
                        android:textColor="#2E7D32"
                        app:chipBackgroundColor="#E8F5E9"
                        app:chipCornerRadius="8dp"
                        app:ensureMinTouchTargetSize="false"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_nums"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="共分析 8 个关键动作分段"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="@id/tv_score" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 详情列表标题 -->
            <LinearLayout
                android:id="@+id/ll_details_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginBottom="8dp"
                android:visibility="visible">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="分段详情分析"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击列表跳转至对应视频片段"
                    android:textColor="#999999"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 列表 (需要给 RecyclerView 一个固定高度或者使其能够在 NestedScrollView 中正确显示) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="visible"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 底部操作栏 (固定在底部) -->
    <LinearLayout
        android:id="@+id/bottom_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_load_doctor"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="标准视频"
            app:icon="@android:drawable/ic_menu_gallery"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_load_patient"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="用户视频"
            app:icon="@android:drawable/ic_menu_camera"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="开始分析" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>