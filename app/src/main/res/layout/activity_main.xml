        <LinearLayout
            android:id="@+id/tab_plan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_plan"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/title_plan"
                android:src="@drawable/plan_selector" />

            <TextView
                android:id="@+id/label_plan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="@string/title_plan"
                android:textColor="@color/bottom_nav_text_color"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_my"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_my"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/title_my"
                android:src="@drawable/my_selector" />

            <TextView
                android:id="@+id/label_my"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="@string/title_my"
                android:textColor="@color/bottom_nav_text_color"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>